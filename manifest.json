{
  "manifest_version": 3,
  "name": "TransHub",
  "version": "0.3.2",
  "description": "點擊英文單詞或句子，實時翻譯為繁體中文。支持騰訊雲、阿里雲、百度、有道，免費額度用盡自動切換。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://fanyi-api.baidu.com/*",
    "https://openapi.youdao.com/*",
    "https://tmt.tencentcloudapi.com/*",
    "https://mt.cn-hangzhou.aliyuncs.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/selection-card.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "翻譯設置",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
